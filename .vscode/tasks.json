{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Folio: Build",
      "type": "npm",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": [
        "$tsc"
      ],
      "script": "build"
    },
    {
      "label": "Folio: Test all",
      "type": "npm",
      "script": "test:all",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "problemMatcher": [
        "$tsc"
      ],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    }
  ]
}
